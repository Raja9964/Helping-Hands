# Copy to .env and adjust. `npm run dev:memory` needs none of this.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/givetrack

# Password for the /admin dashboard (min 8 characters).
ADMIN_PASSWORD=

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Number of reverse proxies in front of the app (for correct client IPs in rate limiting).
TRUST_PROXY=0
